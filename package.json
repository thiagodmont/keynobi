{
  "name": "keynobi",
  "version": "0.1.26",
  "description": "Keynobi - AI-First Android Companion App",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typescript:check": "npx tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "rust:check": "cd src-tauri && cargo check",
    "generate:bindings": "cd src-tauri && cargo test && echo 'TypeScript bindings regenerated in src/bindings/'",
    "check:bindings": "npm run generate:bindings && git diff --exit-code src/bindings/",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:ds": "npm run typescript:check && npm run lint && npm run test:storybook",
    "storybook": "STORYBOOK=true SENTRY_AUTH_TOKEN= storybook dev --port 6006",
    "storybook:build": "STORYBOOK=true SENTRY_AUTH_TOKEN= storybook build",
    "storybook:preview": "http-server storybook-static -a 127.0.0.1 -p 6106 -c-1 -s",
    "test:storybook": "playwright test --config playwright.storybook.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev:web": "vite --mode e2e",
    "perf:collect": "node scripts/collect-metrics.mjs",
    "perf:report": "node scripts/collect-metrics.mjs --report",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "version:bump": "node scripts/bump-version.mjs",
    "release": "node scripts/release.mjs",
    "build:dmg": "tauri build --target aarch64-apple-darwin --bundles dmg",
    "build:dmg:intel": "tauri build --target x86_64-apple-darwin --bundles dmg",
    "build:dmg:universal": "tauri build --target universal-apple-darwin --bundles dmg",
    "prepare": "husky"
  },
  "license": "MIT",
  "dependencies": {
    "@sentry/browser": "^10.59.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@solidjs/testing-library": "^0.8.10",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.3.6",
    "@tauri-apps/cli": "^2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/ui": "^4.1.6",
    "eslint": "^10.4.0",
    "eslint-plugin-solid": "^0.14.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "storybook": "^10.3.6",
    "storybook-solidjs-vite": "^10.0.12",
    "typescript": "~6.0.3",
    "vite": "^8.0.12",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
